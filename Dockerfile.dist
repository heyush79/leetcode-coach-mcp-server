# Packages an already-built jar, for the multi-architecture release image.
#
# The jar is pure Java and so identical on every architecture. Building it once on the runner and
# copying it into each image is minutes faster than the source-building Dockerfile, which under
# emulation would run a full Maven build for arm64 as well.
#
# Use the plain Dockerfile to build from source; this one expects `mvn package` to have run.
FROM eclipse-temurin:17-jre

# curl is only here so the health check can ask the app whether it is actually serving, rather
# than merely whether the port is open.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN useradd --system --uid 10001 appuser && mkdir -p /app/data && chown -R appuser:appuser /app

ARG JAR_FILE=target/leetcode-coach-mcp-server-*.jar
COPY --chown=appuser:appuser ${JAR_FILE} app.jar

USER appuser
EXPOSE 8080

# Listen on every interface inside the container; what is actually reachable is decided by how the
# port is published. The README publishes to 127.0.0.1 so the server stays on the user's machine.
ENV SERVER_ADDRESS=0.0.0.0
ENV SQLITE_URL=jdbc:sqlite:/app/data/leetcode-coach.db
VOLUME ["/app/data"]

HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:8080/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
