# LeetCode account access. Required for submission sync; public problem lookups work without it.
# Never commit real values. Both values expire and are equivalent to account credentials.
# From leetcode.com in your browser: DevTools > Application > Cookies > leetcode.com,
# copy LEETCODE_SESSION and csrftoken.
LEETCODE_SESSION=
LEETCODE_CSRF_TOKEN=
LEETCODE_REMOTE_ENABLED=true
LEETCODE_TIMEOUT_SECONDS=8

# Background submission sync. Runs only when the cookie above is set.
LEETCODE_SYNC_ENABLED=true
LEETCODE_SYNC_INTERVAL_SECONDS=900

# Optional inbound protection for /mcp. Leave blank for localhost-only development.
MCP_API_KEY=
MCP_ALLOWED_ORIGIN_HOSTS=localhost,127.0.0.1

# Default binds only to localhost. Set 0.0.0.0 only inside a controlled container/network.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SQLITE_URL=jdbc:sqlite:./data/leetcode-coach.db
