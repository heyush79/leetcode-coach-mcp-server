{
  "manifest_version": 3,
  "name": "LeetCode Coach Sync",
  "version": "1.0.0",
  "description": "Sends your own LeetCode submissions to your LeetCode Coach server. Your session cookie never leaves this browser.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeetCode Coach Sync"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
